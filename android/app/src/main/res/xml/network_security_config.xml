<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed only for the in-process Go server on the loopback
     interface; everything else keeps the platform default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
